df$Group <- ifelse(grepl("good", rownames(feature)), "Good", "Poor")
df <- df |>
pivot_longer(-Group, names_to = "var", values_to = "val")
top5 <- df |>
group_by(var) |>
summarise(rank = mean(val[Group == "Good"]) - mean(val[Group == "Poor"])) |>
slice_max(abs(rank), n = 5) |>
pull(var)
df |>
filter(var %in% top5) |>
ggplot(aes(y = var, x = val, fill = Group)) +
geom_boxplot() +
theme_bw() +
labs(y="Gene", x="Nearest Neighbour Correlation")
